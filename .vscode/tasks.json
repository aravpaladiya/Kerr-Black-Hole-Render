{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "gcc: Precompile PCH",
            "command": "gcc",
            "args": [
                "-x", "c++-header",
                "-I${workspaceFolder}/GraphicsEngine/include",
                "-o", "${workspaceFolder}/GraphicsEngine/pch.h.gch",  // Output .gch file in GraphicsEngine directory
                "${workspaceFolder}/GraphicsEngine/pch.h"  // Path to pch.h header file
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            },          
            "problemMatcher": [],
            "runOptions": {
                "runOn": "folderOpen"
            }
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                
                "-fdiagnostics-color=always",
                "-I${workspaceFolder}/GraphicsEngine/include",
                "-L${workspaceFolder}/GraphicsEngine/lib",
                // "-include", "${workspaceFolder}/GraphicsEngine/pch.h",  // Include precompiled header from GraphicsEngine directory
                "${workspaceFolder}/GraphicsEngine/*.cpp",  // Source files in GraphicsEngine directory
                "${workspaceFolder}/GraphicsEngine/glad.c",  // Path to glad.c
                "-lglfw3dll",
                "-lassimp",
                "-o", "${workspaceFolder}/GraphicsEngine/${fileBasenameNoExtension}.exe",
                "-I", "C:/Users/aravp/OneDrive/Documents/Thirdpartylibraries/Include"
            ],
            "options": {
                "cwd": "${workspaceFolder}/GraphicsEngine"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Task generated by Debugger."
        }
    ]
}
